{
  "name": "moqt-js",
  "version": "2026.1.0",
  "description": "MOQT (Media over QUIC Transport) client library",
  "keywords": [
    "moqt",
    "webtransport"
  ],
  "license": "Apache-2.0",
  "author": "Shiguredo Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiguredo/moqt-js.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "vite devtools",
    "dev:examples": "vite examples",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:devtools": "vite build devtools",
    "build:examples": "vite build examples",
    "fmt": "oxfmt --write .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e-test": "pnpm build && playwright test --project='chromium'",
    "e2e-test-chrome": "pnpm build && playwright test --project='Google Chrome*'",
    "e2e-test-edge": "pnpm build && playwright test --project='Microsoft Edge*'",
    "e2e-test-webkit": "pnpm build && playwright test --project='WebKit'"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "fast-check": "4.5.3",
    "oxfmt": "0.23.0",
    "oxlint": "1.38.0",
    "oxlint-tsgolint": "0.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "4.0.16"
  }
}
