{
  "name": "moqt-js",
  "version": "2026.2.0",
  "description": "MOQT (Media over QUIC Transport) client library for browsers",
  "keywords": [
    "moqt",
    "webtransport"
  ],
  "license": "Apache-2.0",
  "author": "Shiguredo Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiguredo/moqt-js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vp dev devtools",
    "dev:examples": "vp dev examples",
    "build": "vp pack",
    "build:devtools": "vp build devtools",
    "build:examples": "vp build examples",
    "fmt": "vp fmt --write .",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "test:cov": "vp test --coverage",
    "test:watch": "vp test --watch",
    "e2e-test": "vp run build && vp exec playwright test --project='chromium'",
    "e2e-test-chrome": "vp run build && vp exec playwright test --project='Google Chrome*'",
    "e2e-test-edge": "vp run build && vp exec playwright test --project='Microsoft Edge*'",
    "e2e-test-webkit": "vp run build && vp exec playwright test --project='WebKit'"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@11.18.0"
}
