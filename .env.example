# Playwright E2E テスト用の環境変数テンプレート
# このファイルを .env にコピーして実値を入れる
# .env (.env*) は .gitignore で除外され .env.example のみコミットされる

# MOQT サーバの URI (moqt://...)
# draft-ietf-moq-transport-18 §3.1.1 (MOQT URI Scheme)
TEST_MOQT_QUIC_URI=

# Authorization Token (任意。設定された場合のみ token 経路の spec が動く)
TEST_MOQT_AUTH_TOKEN=
