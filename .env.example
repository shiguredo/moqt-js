# Playwright E2E テスト用の環境変数テンプレート
# このファイルを .env にコピーして実値を入れる
# .env (.env*) は .gitignore で除外され .env.example のみコミットされる

# MOQT リレーの URI (moqt://...)
# 未設定の場合、tests/e2e/relay/ のテストは skip として記録される
# (実リレーを持たない環境や fork からの PR では失敗させない)
# draft-ietf-moq-transport-23 Section 6.1 (MOQT URI Scheme)
TEST_MOQT_URI=

# 複数の MOQT リレーの URI (カンマ区切り)
# リレーをまたぐ SUBSCRIBE_TRACKS のテストが使う。TEST_MOQT_URI が未設定のときは
# 単一リレーのテストも先頭の URI を使う。2 本に満たない場合はそのテストだけを skip する
TEST_MOQT_URIS=
